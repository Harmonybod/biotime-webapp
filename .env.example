# BioTime API
BIOTIME_BASE_URL=http://127.0.0.1:80
BIOTIME_USERNAME=changeme
BIOTIME_PASSWORD=changeme
# "Token" for a general/long-lived token, or "JWT" for a JWT that re-authenticates on expiry
BIOTIME_AUTH_SCHEME=JWT

# Postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/biotime_leave

# Background sync
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15
