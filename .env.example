# BioTime API
# Normally left blank: the app asks for these on its /setup page on first
# start and saves them. Only used if nothing has been saved there yet.
BIOTIME_BASE_URL=
BIOTIME_USERNAME=
BIOTIME_PASSWORD=
# "Token" for a general/long-lived token, or "JWT" for a JWT that re-authenticates on expiry
BIOTIME_AUTH_SCHEME=JWT

# Database: a local SQLite file, created automatically on first start.
DATABASE_URL=sqlite:///./biotime.db
# To use Postgres instead:
# DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/biotime_leave

# Let an ERP/payroll system on another computer call the client API
# (it still needs an API key from the API Integrations page). Restart after changing.
API_NETWORK_ACCESS=false

# Background sync
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15

# Work schedule for the attendance reports (applies to all employees)
SHIFT_START=08:00
SHIFT_END=17:00
SHIFT_BREAK_MINUTES=60
# 0=Monday ... 6=Sunday
SHIFT_WORK_DAYS=0,1,2,3,4
LATE_GRACE_MINUTES=0
